    <!-- Guidance cards -->
    <string name="card_profile_title">Bluetooth connection needs update</string>
    <string name="card_profile_body">Your computer is connected over Bluetooth but has not enabled PadLink as a mouse. Tap Connect. If that fails, remove PadLink from the computer\'s Bluetooth devices and pair again.</string>
    <string name="card_disconnected_title">Computer not reachable</string>
    <string name="card_disconnected_body">Make sure the computer is on, in range, and has Bluetooth enabled. PadLink keeps retrying.</string>
    <string name="card_no_target_title">Choose a computer</string>
    <string name="card_no_target_body">Pair your computer with this phone in Bluetooth settings, then pick it from the menu under the title. A computer that connects to PadLink by itself is selected automatically.</string>
    <string name="card_adb_title">Waiting for PadLink Helper</string>
    <string name="card_adb_body">Connect the USB cable, allow USB debugging, and start PadLink Helper on the computer. It sets up the connection with adb automatically.</string>
    <string name="card_tether_title">Waiting for PadLink Helper</string>
    <string name="card_tether_body">USB tethering is on. Start PadLink Helper on the computer; you will be asked to approve it the first time.</string>
    <string name="card_hotspot_title">Waiting for PadLink Helper</string>
    <string name="card_hotspot_body">Mobile Hotspot is on. Connect the computer\'s Wi-Fi to this hotspot, set PadLink Helper to Wi-Fi (Phone hotspot), and approve it the first time. A 5 GHz hotspot band tracks more smoothly than 2.4 GHz.</string>
    <string name="hotspot_address">Hotspot address: %1$s</string>
    <string name="drop_connected">Last connection from %1$s ended: %2$s</string>
    <string name="drop_attempt">Last attempt from %1$s failed: %2$s</string>
    <string name="drop_helper_silent">the computer stopped sending data for 3 seconds.</string>
    <string name="drop_helper_closed">the helper closed the connection. Check that only one copy of PadLink Helper is running.</string>
    <string name="drop_no_hello">the helper connected but never introduced itself.</string>
    <string name="drop_replaced">another helper connection took over.</string>
    <string name="drop_protocol_error">the helper sent data this app does not understand. Update both apps.</string>
    <string name="drop_network_error">the network connection failed.</string>
    <string name="card_bt_off_title">Bluetooth is off</string>
    <string name="card_bt_off_body">Turn on Bluetooth to use PadLink as a wireless mouse and pen.</string>
    <string name="card_permission_title">Permission needed</string>
    <string name="card_permission_body">PadLink needs the Nearby devices permission to act as a Bluetooth mouse.</string>
    <string name="card_bt_unsupported_title">Bluetooth not available</string>
    <string name="card_bt_unsupported_body">This device has no Bluetooth. Use one of the USB or Wi-Fi modes instead.</string>
    <string name="card_hid_title">Bluetooth mouse mode unavailable</string>
    <string name="card_hid_body">This phone did not allow PadLink to register as a Classic Bluetooth mouse. Another app may be using it. Bluetooth Low Energy mode usually works instead.</string>
    <string name="card_ble_title">Bluetooth LE advertising failed</string>
    <string name="card_ble_body">The phone could not advertise PadLink over Bluetooth Low Energy. Turn Bluetooth off and on, then tap Connect.</string>
    <string name="card_tether_off_title">USB tethering is off</string>
    <string name="card_tether_off_body">Connect the USB cable and turn on USB tethering, then start PadLink Helper on the computer.</string>
    <string name="card_hotspot_off_title">Mobile Hotspot is off</string>
    <string name="card_hotspot_off_body">Turn on Mobile Hotspot, connect the computer\'s Wi-Fi to it, then start PadLink Helper. For smoother tracking, set the hotspot band to 5 GHz in its settings.</string>
    <string name="card_port_title">Connection port busy</string>
    <string name="card_port_body">Another app is using TCP port 47800 on this phone. Close it and PadLink retries automatically.</string>

